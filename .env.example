APP_NAME=Pipeline Monitor
APP_ENV=development
DEBUG=True

DATABASE_URL=postgresql://postgres:YOURPASS@localhost:5432/pipeline_monitor

GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

